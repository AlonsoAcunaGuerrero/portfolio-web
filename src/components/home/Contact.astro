---
import { BiLogoLinkedin, BiLogoGmail } from "react-icons/bi";
import { PiGithubLogoFill } from "react-icons/pi";
import { ImProfile } from "react-icons/im";
import type { IconType } from "react-icons";

export interface ContactData {
	url: string;
	name: string;
	icon: IconType;
}

const pathname: string = Astro.url.pathname;

const language: string = pathname.split("/")[2]

const cvFilePath: string = language === 'es' 
	? "/portfolio-web/CV ATS - ES - Alonso Acuña.pdf" 
	: "/portfolio-web/CV ATS - EN - Alonso Acuña.pdf";

const listOfContactsForm: ContactData[] = [
	{
		url: 'https://www.linkedin.com/in/alonso-acu%C3%B1a-guerrero-b5a014271/',
		icon: BiLogoLinkedin,
		name: 'LinkedIn' 
	},
	{
		url: 'https://github.com/AlonsoAcunaGuerrero',
		icon: PiGithubLogoFill,
		name: 'Github'
	},
	{
		url: 'mailto:alonso.ag555@gmail.com',
		icon: BiLogoGmail,
		name: 'Gmail'
	}
]
---

<div class='contact-resume-box'>
    <div class='contact-resume-container'>
		<a class='contact-item' href={cvFilePath}>
			<ImProfile />
			<span>CV</span>
		</a>

		{
			listOfContactsForm.map((contact) => 
				<a class='contact-item' target='_blank' href={contact.url}>
					<contact.icon />
					<span>{contact.name}</span>
				</a>
			)
		}
    </div>
</div>

<style>
    .contact-resume-box {
		display: flex;
		flex-direction: column;
		padding: 0.25em;
		gap: 0.5em;
		border-radius: 1em;
		align-items: baseline;
		max-width: auto;
		transition: max-width 400ms ease-out 700ms;
	}

	.contact-resume-container {
		display: flex;
		flex-direction: row;
		gap: 0.75em;
		border-radius: 1em;
		opacity: 1;
		transition: opacity 200ms ease-in 900ms;
	}

    .contact-item {
		display: flex;
		background-color: black;
		padding: 0.5em;
		border-radius: 0.25em;
		opacity: 1;
		align-items: center;
		justify-content: center;
		transition: opacity 2s ease-in 700ms, transform 90ms ease-in 35ms;
	}

	.contact-item:hover {
		transform: scale(1.1);
	}

	.contact-item > span {
		font-size: 1.25em;
		color: white;
		padding: 0 1em;
	}

	.contact-item > svg {
		font-size: 1.5em;
		color: black;
		background-color: white;
		border-radius: 0.15em;
	}

	.contact-item:nth-child(1) {
		animation-delay: 0s;
	}

	.contact-item:nth-child(2) {
		animation-delay: 1s;
	}
	
	.contact-item:nth-child(3) {
		animation-delay: 2s;
	}

	@starting-style {
		.contact-item {
			opacity: 0;
		}
	}

	@media (min-width: 768px) {
		.contact-resume-box {
			padding: 0.5em;
		}
		
		.contact-item > svg {
			font-size: 3em;
		}
	}

    @media (min-width: 1024px) {
        .contact-item > svg {
			font-size: 2em;
		}
	}
</style>