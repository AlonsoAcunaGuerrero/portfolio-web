---
import About from "./About.astro";
import Contact from "./Contact.astro";

interface Props {
	title: string;
	presentationTitles: string[];
	infoAboutMe: string;
}

const { title, presentationTitles, infoAboutMe } = Astro.props as Props;
---

<div class='home-main-container'>
    <h1>{
		presentationTitles.map((title) => 
		<span>{title}</span>
	)
	}</h1>

    <About title={title} infoAboutMe={infoAboutMe} />

    <Contact />
</div>

<style>
    .home-main-container {
		display: flex;
		flex-direction: column;
		background-color: #1a1a1a;
		position: relative;
		justify-content: space-between;
		padding: 1em;
        height: calc(100vh - 60px);
	}

	.home-main-container > h1 {
		display: flex;
		flex-direction: column;
		width: 100%;
		opacity: 1;
		transition: opacity 2000ms ease-in 50ms;
	}

	.home-main-container > h1 > span {
		font-size: clamp(2em, 4.75vh, 2.75em);
		text-align: center;
	}

	@starting-style {
		.home-main-container > h1 {
			opacity: 0;
		}
	}

	@media (min-width: 768px) {
		.home-main-container > h1 > span {
			font-size: clamp(3em, 5.75vh, 4.5em);
		}
	}


    @media (min-width: 1024px) {
		.home-main-container > h1 {
			position: absolute;
			left: 0px;
			right: 0px;
		}

		.home-main-container > h1 > span {
			font-size: 4.25em;
			text-align: center;
		}
	}
</style>