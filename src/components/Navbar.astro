---
interface Props {
	listOfNavItems: NavItem[]
}

export interface NavItem {
    name: string,
    path: string
}

const { listOfNavItems } = Astro.props as Props;
---

<nav>
    <div>
        <div>
        </div>

        <ul>
            {
                listOfNavItems.map((navItem) => 
                    <li>
                        <a href={navItem.path} class="nav-item">{navItem.name}</a>
                    </li>
                )
            }
        </ul>
    </div>
</nav>

<style>
    nav {
        height: 60px;
        width: 100%;
        position: fixed;
        background-color: rgb(40, 40, 40);
        padding: 0 2em;     
        z-index: 2;   
    }

    nav div {
        display: flex;
        height: 100%;
        color: white;
        justify-content: space-between;
        align-items: center;
    }

    ul {
        display: flex;
        flex-direction: row;
        height: 100%;
        column-gap: 1.25em;
    }

    ul li {
        display: flex;
        align-items: center;
    }

    .nav-item {
        color: white;
        font-size: 1.35em;
        text-decoration-line: underline;
        text-decoration-color: transparent;
        text-decoration-thickness: 2px;
        text-underline-offset: 6px;
        transition: text-decoration-color 0.3s ease;
    }

    .nav-item:hover {
        text-decoration-color: white;
    }
</style>