---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { } = Astro.props;
---

<nav>
    <div>
        <div>
        </div>

        <ul class="nav-items-container">
            <li>
                <a href="#home" class="nav-item">{t("navbar.home")}</a>
            </li>

            <li>
                <a href="#skills" class="nav-item">{t("navbar.skills")}</a>
            </li>

            <li>
                <a href="#projects" class="nav-item">{t("navbar.projects")}</a>
            </li>
        </ul>
    </div>
</nav>

<style>
    nav {
        height: 60px;
        width: 100%;
        position: fixed;
        background-color: rgb(40, 40, 40);
        padding: 0 2em;     
        z-index: 2;   
    }

    nav div {
        display: flex;
        height: 100%;
        color: white;
        justify-content: space-between;
        align-items: center;
    }

    .nav-items-container {
        display: flex;
        flex-direction: row;
        height: 100%;
        column-gap: 1.25em;
    }

    .nav-items-container li {
        display: flex;
        align-items: center;
    }

    .nav-item {
        color: white;
        font-size: 1.35em;
        text-decoration-line: underline;
        text-decoration-color: transparent;
        text-decoration-thickness: 2px;
        text-underline-offset: 6px;
        transition: text-decoration-color 0.3s ease;
    }

    .nav-item:hover {
        text-decoration-color: white;
    }
</style>