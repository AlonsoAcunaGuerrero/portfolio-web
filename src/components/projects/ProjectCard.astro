---
import { Image } from 'astro:assets';
import type { Project } from './ProjectsPanel.astro';
import { FaGithub } from "react-icons/fa";
import { TiArrowSortedUp } from "react-icons/ti";

interface Props extends Project{
    cardFLTitle: string
}

const { name, description, img, listOfFramesLibs, frontend_url, backend_url, cardFLTitle } = Astro.props as Props;
---

<div class='project-card'>
    <div class='image-container'>
        <Image class={"image"} src={img} alt="" height={135} />
    </div>

    <div class='project-info'>
        <h2 class='project-name'>{name}</h2>

        <p class='project-description''>{description}</p>
    </div>

    <div class="fl-box">
        <h3>{cardFLTitle}</h3>
        <ul class="fl-container">
            {
                listOfFramesLibs.map((fl) => 
                <li class="fl-item">
                    <fl.icon />
                    <span>{fl.name}</span>
                </li>
            )
            }
        </ul>
    </div>

    <div class='resources-titles-container'>
        <span class='frontend-title'>Frontend</span>
        <span class='backend-title''>Backend</span>
    </div>

    <div class='resources-links-container'>
        <a href={frontend_url} target='_blank' class='btn-frontend'>
            <FaGithub />
            <TiArrowSortedUp />
        </a>

        <a href={backend_url} target='_blank' class='btn-backend'>
            <FaGithub />
            <TiArrowSortedUp />
        </a>
    </div>
</div>

<style>
    .project-card {
        display: flex;
		flex-direction: column;
		list-style: none;
		height: 100%;
		width: 100%;
		color: black;
		padding: 0.5em;
		background-color: rgb(255, 255, 255);
		border-style: solid;
		border-width: 2px;
		border-color: rgb(216, 216, 216);
		border-radius: 1em;
		gap: 0.75em;
		transition-property: all;
		transition-timing-function: ease-in;
		transition-duration: 200ms;
		transition-delay: 50ms;
	}

    .project-card:hover {
		outline-offset: 8px;
		outline-color: white;
		outline-style: solid;
        outline-width: 0.25em;
	}

    .image-container {
        display: flex;
		background-color: white;
		align-items: center;
		justify-content: center;
		overflow: hidden;
        border-radius: 1.5em;
        padding: 0.25em;
        min-width: 150px;
    }

    .image {
        display: flex;
        aspect-ratio: 1 / 1;
    }

    .project-info {
        display: flex;
        flex-direction: column;
        gap: 0.5em;
        width: 100%;
    }

    .project-name, .project-description {
        color: black;
        text-align: center;
        width: 100%;
    }
    
    .project-name {
        font-size: 1.75em;
        font-weight: bold;
    }

    .project-description {
        font-size: 1.5em;
    }

    .resources-titles-container {
        display: flex;
        flex-direction: row;
        width: 100%;
        align-items: center;
        justify-content: center;
    }

    .resources-titles-container > span {
        width: 100%;
        text-align: center;
        font-size: 1.5em;
        font-weight: bold;
    }

    .resources-links-container {
        display: flex;
        flex-direction: row;
    }

    .btn-frontend, .btn-backend {
        display: flex;
        background-color: transparent;
        align-items: center;
		justify-content: center;
        border-style: solid;
        padding: 0.25em;
        transition-property: all;
		transition-timing-function: ease-out;
		transition-duration: 500ms;
		transition-delay: 50ms;
        position: relative;
        width: 100%;
        height: 4.5em;
    }

    .btn-frontend {
        border-color: rgb(84, 0, 99);
        border-width: 0.25em 0 0.25em 0.25em;
        border-radius: 1em 0 0 1em;
    }

    .btn-backend {
        border-color: rgb(193, 112, 0);
        border-width: 0.25em 0.25em 0.25em 0;
        border-radius: 0 1em 1em 0 ;
    }

    .btn-frontend > svg, 
    .btn-backend > svg {
        position: absolute;
        transition-property: transform;
		transition-timing-function: ease-out;
    }

    .btn-frontend > svg:first-child,
    .btn-backend > svg:first-child {
        color: black;
        font-size: 3em;
        transition-duration: 250ms;
        transition-delay: 50ms;
    }

    .btn-frontend > svg:nth-child(2),
    .btn-backend > svg:nth-child(2) {
        color: transparent;
        font-size: 3em;
        visibility: hidden;
        transition-property: visibility;
        transition-duration: 0ms, 500ms;
        transition-delay: 350ms;
    }

    .btn-frontend > svg:nth-child(2) {
        transform: translateX(-0.75em) rotate(-90deg);
    }

    .btn-backend > svg:nth-child(2) {
        transform: translateX(0.75em) rotate(90deg);
    }

    .btn-frontend:hover {
        background-color: rgb(84, 0, 99);
    }
    .btn-backend:hover {
        background-color: rgb(193, 112, 0);
    }

    .btn-frontend:hover > svg,
    .btn-backend:hover > svg {
        color: white;
    }

    .btn-frontend:hover > svg:first-child {
        transform: translateX(0.25em);
    }

    .btn-backend:hover > svg:first-child {
        transform: translateX(-0.25em);
    }

    .btn-frontend:hover > svg:nth-child(2),
    .btn-backend:hover > svg:nth-child(2) {
        visibility: visible;
    }

    @media (min-width: 768px) {

    }

    @media (min-width: 1024px) {
        .btn-frontend,
        .btn-backend {
            height: 4.5em;
        }

        .btn-frontend > svg:first-child,
        .btn-backend > svg:first-child {
            font-size: 3em;
        }

        .btn-frontend > svg:nth-child(2),
        .btn-backend > svg:nth-child(2) {
            font-size: 3em;
        }
    }

    {/* Frames & Libs */}

    .fl-box {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 0.5em;
    }

    .fl-box > h3 {
        font-size: 1.5em;
        width: 100%;
        text-align: center;
    }

    .fl-container {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        width: 100%;
        gap: 0.5em;
    }

    .fl-item {
		display: flex;
		flex-direction: column;
		width: 100%;
		font-size: 1em;
        list-style: none;
		align-items: center;
        justify-content: center;
		text-align: center;
		padding: 0.25em;
		border-radius: 0.25em;
		background-color: black;
		color: white;
	}

    .fl-item > svg {
		font-size: 2.5em;
	}

	.fl-item > span {
		font-style: italic;
		font-size: 1.2em;
	}
</style>