---
import { Image } from "astro:assets";
import type { Project } from "./ProjectsPanel.astro";
import { FaGithub } from "react-icons/fa";
import { TiArrowSortedUp } from "react-icons/ti";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const btnShowInfoText: string = t("projects.btn_show_info");

const { name, description, img, frontendUrl, backendUrl } = Astro.props as Project;
---

<div class="project-card">
    <div class="image-container">
        <Image class={"image"} src={img} alt="" height={135} />
    </div>

    <div class="project-info">
        <h2 class="project-name">{name}</h2>

        <p class="project-description" '>{description}</p>
    </div>

    <button
        class="btn-show-info"
        data-name={name}
        data-description={description}
        data-img={img.src}
        data-frontend-url={frontendUrl}
        data-backend-url={backendUrl}
    >
        {btnShowInfoText}
    </button>
</div>

<script>
    import type { ProjectData } from "../../types";

    export const showAlert = (config: ProjectData) => {
        const event = new CustomEvent("project:show", { detail: config });
        window.dispatchEvent(event);
    };

    const buttons = document.querySelectorAll(".btn-show-info");

    buttons.forEach((button) => {
        button.addEventListener("click", (e) => {
            const target = e.currentTarget as HTMLButtonElement;
            const name = target.dataset.name ?? "No Name";
            const description = target.dataset.description ?? "";
            const img = target.dataset.img;

            const frontendUrl = target.dataset.frontendUrl ?? "#";
            const backendUrl = target.dataset.backendUrl ?? "#"

            showAlert({
                name: name,
                description: description,
                imgPath: img,
                frontendUrl: frontendUrl,
                backendUrl: backendUrl
            });
        });
    });
</script>

<style>
    .project-card {
        display: flex;
        flex-direction: column;
        list-style: none;
        height: 100%;
        width: 100%;
        color: black;
        padding: 0.5em;
        background-color: rgb(255, 255, 255);
        border-style: solid;
        border-width: 2px;
        border-color: rgb(216, 216, 216);
        border-radius: 1em;
        gap: 0.75em;
        transition-property: all;
        transition-timing-function: ease-in;
        transition-duration: 200ms;
        transition-delay: 50ms;
    }

    .project-card:hover {
        outline-offset: 8px;
        outline-color: white;
        outline-style: solid;
        outline-width: 0.25em;
    }

    .image-container {
        display: flex;
        background-color: white;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 1.5em;
        padding: 0.25em;
        min-width: 150px;
    }

    .image {
        display: flex;
        aspect-ratio: 1 / 1;
    }

    .project-info {
        display: flex;
        flex-direction: column;
        gap: 0.5em;
        width: 100%;
    }

    .project-name,
    .project-description {
        color: black;
        text-align: center;
        width: 100%;
    }

    .project-name {
        font-size: 1.75em;
        font-weight: bold;
    }

    .project-description {
        font-size: 1.5em;
    }

    .btn-show-info {
        background-color: var(--primary-color);
        padding: 0.25em;
        font-size: 1.5em;
        color: var(--secondary-color);
        border-radius: 0.5em;
        border-width: 0.2em;
        border-style: solid;
        border-color: var(--secondary-color);
        transition-property: all;
        transition-duration: 175ms;
        transition-delay: 25ms;
    }

    .btn-show-info:hover {
        background-color: var(--tertiary-color);
        color: var(--primary-color);
        cursor: pointer;
    }

    @media (min-width: 768px) {
    }

    /* @media (min-width: 1024px) {
        .btn-frontend,
        .btn-backend {
            height: 4.5em;
        }

        .btn-frontend > svg:first-child,
        .btn-backend > svg:first-child {
            font-size: 3em;
        }

        .btn-frontend > svg:nth-child(2),
        .btn-backend > svg:nth-child(2) {
            font-size: 3em;
        }
    } */

    .fl-box {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 0.5em;
    }

    .fl-box > h3 {
        font-size: 1.5em;
        width: 100%;
        text-align: center;
    }

    .fl-container {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        width: 100%;
        gap: 0.5em;
    }

    .fl-item {
		display: flex;
		flex-direction: column;
		width: 100%;
		font-size: 1em;
        list-style: none;
		align-items: center;
        justify-content: center;
		text-align: center;
		padding: 0.25em;
		border-radius: 0.25em;
		background-color: black;
		color: white;
	}

    .btn-resource:hover > svg:first-child {
        transform: translateY(-0.4em);
    }
</style>
