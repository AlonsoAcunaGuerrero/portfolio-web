---
import SectionPanel from "../../layouts/SectionPanel.astro";
import ProjectCard from './ProjectCard.astro';
import type { FrameLib } from "../skills/FrameLibCard.astro";

interface Props {
    title: string,
    listOfProjects: Project[],
    cardFLTitle: string
}

export interface Project {
    name: string,
    description: string,
	img: ImageMetadata,
    listOfFramesLibs: FrameLib[],
    frontend_url: string,
    backend_url: string
}

const { title, listOfProjects, cardFLTitle } = Astro.props as Props;
---
<SectionPanel title={title}>
    <ul class='cards-container'>
        {
            listOfProjects?.map((project) => 
                <li class='card-item'>
                    <ProjectCard name={project.name} description={project.description} 
                    img={project.img} listOfFramesLibs={project.listOfFramesLibs} 
                    frontend_url={project.frontend_url} backend_url={project.backend_url}
                    cardFLTitle={cardFLTitle} />
                </li> 
            )
        }
    </ul>
</SectionPanel>

<style>
    .cards-container {
        display: grid;
        gap: var(--cards-separation);
        width: 100%;
        padding-top: var(--top-separation);
        grid-template-columns: repeat(1, minmax(0, 1fr));
    }
    
    .card-item {
        padding: 1em;
    }

    @media (min-width: 768px) {
        .cards-container {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 1280px) {
        .cards-container {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>