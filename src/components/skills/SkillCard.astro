---
import { Image } from 'astro:assets';
import type { FrameLib } from './FrameLibCard.astro';
import FrameLibCard from './FrameLibCard.astro';


interface Props {
	name: string,
	img: ImageMetadata,
	framesLibs: FrameLib[]
}

const { name, img, framesLibs } = Astro.props;
---


<div class='skill-card'>
	<div class='img-container'>
		<Image src={img} alt="" height={150} />
		<h2 class='skill-name'>{name}</h2>
	</div>

	{
		framesLibs?.length != 0 ?
		<div class='frames-libs-box'>
			<h3>Frameworks & Libraries</h3>
			<div class='fl-container'>
				{
					framesLibs?.map((value) => 
					<FrameLibCard name={value?.name} icon={value?.icon} />
					)
				}
			</div> 
		</div>
		: null
	}
</div>


<style>
	.frames-libs-box {
		width: 100%;
	}

	.frames-libs-box  > h3 {
		color: white;
		font-size: 1.25em;
	}

	.fl-container {
		display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-top: 0.75em; 
		gap: 0.5em;
		transition: max-width 150ms ease-in-out, opacity 150ms ease-in-out;
	}

	.skill-card {
		list-style: none;
		height: 100%;
		width: 100%;
		display: flex;
		flex-direction: column;
		color: black;
		padding: 1em;
		background-color: rgb(40, 40, 40);
		border-style: solid;
		border-width: 6px;
		border-color: rgb(216, 216, 216);
		border-radius: 1em;
		gap: 0.75em;
		transition-property: all;
		transition-timing-function: ease-in;
		transition-duration: 150ms;
		transition-delay: 50ms;
	}

	.skill-card:hover {
		border-width: 2px;
		box-shadow: 8px 8px rgba(255, 255, 255, 0.75);
		transform: translateY(-4px) translateX(-4px);
	}

	.skill-name {
		display: flex;
		width: 100%;
		background-color: black;
		font-size: 1.5em;
		justify-content: center;
		text-align: center;
		color: white;
		padding: 0.2em;
		text-transform: uppercase;
	}

	.img-container > img {
		padding: 0.75em;
	}

	.img-container {
		display: flex;
		flex-direction: column;
		background-color: white;
		align-items: center;
		justify-content: center;
		border-radius: 0.5em;
		overflow: hidden;
	}


	@media (min-width: 1024px) {
		.fl-container {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>