---
import SectionPanel from "../../layouts/SectionPanel.astro";
import TechList from "./TechList.astro";
import type { Tech } from "../../types";

import { SiActix, SiReact, SiAstro, SiGodotengine, SiPytorch } from "react-icons/si";
import { BiLogoSpringBoot, BiLogoPostgresql } from "react-icons/bi";
import { SiSpringsecurity, SiPython } from "react-icons/si";
import { DiJava } from "react-icons/di";
import { IoAnalytics } from "react-icons/io5";
import { TbBrandCSharp } from "react-icons/tb";
import { GrMysql } from "react-icons/gr";
import { SiJavascript, SiTypescript, SiRust, SiPodman } from "react-icons/si";
import { FaCode, FaServer, FaConnectdevelop } from "react-icons/fa";
import { FaDatabase } from "react-icons/fa6";
import { MdOutlineScreenshotMonitor } from "react-icons/md";
import { TbSql } from "react-icons/tb";
import { IoGameController } from "react-icons/io5";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface Props {
    title: string;
}

const { title } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const lblLanguage: string = t("skills.lbl_language");

const LANGUAGE_LIST: Tech[] = [
    {
        name: "JavaScript",
        icon: SiJavascript,
        tags: ["Frontend"],
    },
    {
        name: "TypeScript",
        icon: SiTypescript,
        tags: ["Frontend"],
    },
    {
        name: "C#",
        icon: TbBrandCSharp,
        tags: ["Backend"],
    },
    {
        name: "Java",
        icon: DiJava,
        tags: ["Backend"],
    },
    {
        name: "Python",
        icon: SiPython,
        tags: ["Data Analysis"]
    },
    {
        name: "Rust",
        icon: SiRust,
        tags: ["Backend"],
    },
    {
        name: "SQL",
        icon: TbSql,
        tags: ["Database"],
    },
];

const FRONTEND_LIST: Tech[] = [
    {
        name: "React",
        icon: SiReact,
        tags: ["JavaScript", "TypeScript"],
    },
    {
        name: "Astro",
        icon: SiAstro,
        tags: ["JavaScript", "TypeScript"],
    },
];

const BACKEND_LIST: Tech[] = [
    {
        name: "Spring Boot",
        icon: BiLogoSpringBoot,
        tags: ["Java"],
    },
    {
        name: "Spring Security",
        icon: SiSpringsecurity,
        tags: ["Java", "Spring Boot"],
    },
    {
        name: "ASP .NET Core",
        icon: TbBrandCSharp,
        tags: ["C#"],
    },
    {
        name: "Actix-Web",
        icon: SiActix,
        tags: ["Rust"],
    },
];

const DEVOPS_LIST: Tech[] = [
    {
        name: "Podman",
        icon: SiPodman,
        tags: ["Containers"]
    },
];

const lblDatabase: string = t("skills.lbl_database");

const DATABASE_LIST: Tech[] = [
    {
        name: "PostgreSQL",
        icon: BiLogoPostgresql,
        tags: ["SQL"],
    },
    {
        name: "MySQL",
        icon: GrMysql,
        tags: ["SQL"],
    },
];

const lblDataAnalysis: string = t("skills.lbl_data_analysis");

const DATA_ANALYSIS_LIST: Tech[] = [
    {
        name: "PyTorch",
        icon: SiPytorch,
        tags: ["Python"]
    }
]

const GAMEDEV_LIST: Tech[] = [
    {
        name: "Godot",
        icon: SiGodotengine,
        tags: ["GDScript"],
    },
];
---

<SectionPanel title={title}>
    <div class="technologies-container">
        <TechList title={lblLanguage} icon={FaCode} techList={LANGUAGE_LIST} />
        <TechList
            title={"Frontend"}
            icon={MdOutlineScreenshotMonitor}
            techList={FRONTEND_LIST}
        />
        <TechList title={"Backend"} icon={FaServer} techList={BACKEND_LIST} />
        <TechList
            title={lblDatabase}
            icon={FaDatabase}
            techList={DATABASE_LIST}
        />
        <TechList
            title={"DevOps"}
            icon={FaConnectdevelop}
            techList={DEVOPS_LIST}
        />
        <TechList
            title={"Game Dev"}
            icon={IoGameController}
            techList={GAMEDEV_LIST}
        />
        <TechList 
            title={lblDataAnalysis}
            icon={IoAnalytics}
            techList={DATA_ANALYSIS_LIST}
        />
    </div>
</SectionPanel>

<style>
    .technologies-container {
        display: grid;
        width: 100%;
        gap: calc(var(--cards-separation));
        grid-template-columns: repeat(12, 1fr);
    }

    /* @media (min-width: 640px) {
        .technologies-container {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1280px) {
        .technologies-container {
            grid-template-columns: repeat(4, 1fr);
        }
    } */
</style>
