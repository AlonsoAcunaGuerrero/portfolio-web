---
import type { Tech } from "../../types";

const { name, icon, tags } = Astro.props as Tech;
---

<div class="tech-card">
    {
        tags && (
            <ul class="tech-tag-container">
                {tags?.map((tag) => (
                    <li class="tech-tag-item">
                        <span>{tag}</span>
                    </li>
                ))}
            </ul>
        )
    }
    <div class="tech-data">
        <Astro.props.icon />
        <span class="tech-name">{name}</span>
    </div>

    
</div>

<style>
    .tech-card {
        list-style: none;
        height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
        padding: 1.5em;
        background-color: var(--primary-color);
        border-radius: 0.5em;
        gap: 1.5em;
        transition-property: all;
        transition-timing-function: ease-in;
        transition-duration: 150ms;
        transition-delay: 50ms;
    }

    .tech-card:hover {
        box-shadow: 8px 8px var(--neutral-color);
        transform: translateY(-4px) translateX(-4px);
    }

    .tech-data {
        display: flex;
        flex-direction: row;
        gap: 1.5em;
        align-items: end;
        color: var(--secondary-color);
    }

    .tech-data > svg {
        font-size: 5.5em;
    }

    .tech-data > .tech-name {
        font-size: 1.75em;
    }

    .tech-tag-container {
        display: flex;
        flex-wrap: wrap;
        flex-direction: row;
        gap: 0.75em;
    }

    .tech-tag-item > span {
        font-size: 1.25em;
        background-color: #555555;
        padding: 0.1em 0.5em;
        border-radius: 0.25em;
    }
</style>
