---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		font-family: system-ui, sans-serif;
		font-size: 16px;
		box-sizing: border-box;
		text-decoration-line: none;
		list-style-type: none;
		/* Global Variables */
		--title-container-h: 10vh;
		--top-separation: 1.5em;
		--cards-separation: 1.25em; 
	}

	@font-face {
		font-family: 'SairaCondensed';
		src: url('../assets/fonts/saira_condensed/SairaCondensed-Medium.ttf') format('truetype');
	}
	
	h1, h2, h3, p, a, span {
		font-family: 'SairaCondensed', sans-serif;
	}
	
	html {
		scroll-behavior: smooth;
	}

	section {
		padding-top: 60px;
		min-height: 100vh;
		background-color: rgb(20, 20, 20);
		color: white;
	}

	#skills, #projects {
		display: flex;
		justify-content: center;
	}
</style>