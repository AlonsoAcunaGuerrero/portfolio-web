---
import Layout from '../../layouts/Layout.astro';
import Navbar, { NavItem } from '../../components/Navbar.astro';
import HomePanel from '../../components/home/HomePanel.astro';
import SkillsPanel from '../../components/skills/SkillsPanel.astro';
import ProjectsPanel, { Project } from '../../components/projects/ProjectsPanel.astro';
import HSLogo from "../../assets/img/Hardware_Shop_Project_Logo.png";
import CTALogo from "../../assets/img/Colaborative_Task_App.png";
import { TbBrandCSharp  } from "react-icons/tb";
import { SiReact, SiActix } from "react-icons/si";

const listOfProjects: Project[] = [
    {
        name: "Hardware Store",
        description: "It's my first project about an e-commerce to sell PC hardware.",
        img: HSLogo,
        listOfFramesLibs: [
			{
                name: 'ReactJS',
                icon: SiReact
            },
			{
                name: 'ASP .Net Core',
                icon: TbBrandCSharp 
            }
		],
        frontend_url: "https://github.com/AlonsoAcunaGuerrero/hardware-store-app",
        backend_url: "https://github.com/AlonsoAcunaGuerrero/hardware-store-api"
    },
    {
        name: "Colaborative Task App",
        description: "It is an application for teamwork and task management.",
        img: CTALogo,
        listOfFramesLibs: [
			{
                name: 'ReactTS',
                icon: SiReact
            },
			{
                name: 'Actix-Web',
                icon: SiActix
            }
		],
        frontend_url: "https://github.com/AlonsoAcunaGuerrero/colaborative-task-app-frontend",
        backend_url: "https://github.com/AlonsoAcunaGuerrero/colaborative-task-app-backend"
    }
]
---

<Layout title='Portfolio - Alonso Acuña'>
	<Navbar listOfNavItems={
		[
			{
				name: "Home",
				path: "#top"
			},
			{
				name: "Skills",
				path: "#skills"
			},
			{
				name: "Projects",
				path: "#projects"
			}
		]
	} />
	<main>
		<section id='home'>
			<HomePanel 
			title='About Me'
			presentationTitles={["Hi, I'm Alonso Acuña", "Full-Stack Web Developer And Game Developer"]}
			infoAboutMe = 'Hello, I am a Systems Engineering student at the University of Guayaquil, 
			interested in programming and managing of networks and servers.' />
		</section>
	</main>

	<section id='skills'>
		<SkillsPanel title='Skills'
		cardFLTitle='Frameworks & Libraries' />
	</section>

	<section id='projects' >
		<ProjectsPanel title='Projects' listOfProjects={listOfProjects}
		cardFLTitle='Frameworks & Libraries' />
	</section>
</Layout>