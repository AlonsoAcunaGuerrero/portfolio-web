---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HomePanel from '../components/home/HomePanel.astro';
import SkillsPanel from '../components/skills/SkillsPanel.astro';
import ProjectsPanel from '../components/projects/ProjectsPanel.astro';
---

<Layout title='Portfolio - Alonso Acuña'>
	<Navbar />
	<main>
		<section id='home'>
			<HomePanel />
		</section>
	</main>

	<section id='skills'>
		<SkillsPanel title='Skills' />
	</section>

	<section id='projects'>
		<ProjectsPanel title='Projects' />
	</section>
</Layout>

<style is:global>
	* {
		box-sizing: border-box;
		padding: 0;
		margin: 0;
		font-size: 16px;
		/* Global Variables */
		--title-container-h: 10vh;
		--top-separation: 1.5em;
		--cards-separation: 1.25em; 
	}

	@font-face {
		font-family: 'SairaCondensed';
		src: url('../assets/fonts/saira_condensed/SairaCondensed-Medium.ttf') format('truetype');
	}
	
	h1, h2, h3, p, a, span {
		font-family: 'SairaCondensed', sans-serif;
	}
</style>

<style>
	html {
		scroll-behavior: smooth;
	}

	section {
		padding-top: 60px;
		min-height: 100vh;
		background-color: rgb(20, 20, 20);
		color: white;
	}
</style>